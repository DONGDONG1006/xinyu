{
  "name": "xinyu-workbench-desktop",
  "version": "5.1.0",
  "description": "甘肃新煜科技工作台 · 独立桌面客户端（Mac / Windows / Linux）",
  "main": "main.js",
  "author": "甘肃新煜科技",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.xinyu.workbench",
    "productName": "新煜工作台",
    "icon": "../icons/icon-512.png",
    "files": ["main.js"],
    "extraResources": [
      { "from": "..", "to": "app", "filter": ["**/*", "!desktop/**", "!node_modules/**"] }
    ],
    "win": { "target": ["portable", "nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.business" },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
